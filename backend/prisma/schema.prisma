generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =====================================================
// ENUMS
// =====================================================

enum CustomerRewardType {
  DIRECT
  CHOICE
}

enum CustomerRewardStatus {
  PENDING
  AVAILABLE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum RewardTier {
  LOW
  MEDIUM
  HIGH
}

enum RewardRedemptionTiming {
  IMMEDIATE
  NEXT_PURCHASE
  NEXT_PURCHASE_DAY
}

enum FrequencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum ValueLevel {
  LOW
  MEDIUM
  HIGH
}

enum CustomerCycleStatus {
  OPEN
  CLOSED
}

// =====================================================
// PERSON
// =====================================================

model Person {
  idPerson    Int       @id @default(autoincrement()) @db.UnsignedInt
  cpf         String    @unique @db.Char(11)
  name        String    @db.VarChar(120)
  email       String?   @db.VarChar(150)
  phoneNumber String?   @db.VarChar(20)
  dateOfBirth DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyPeople CompanyPerson[]
  user          User?
}

// =====================================================
// COMPANY
// =====================================================

model Company {
  idCompany Int @id @default(autoincrement()) @db.UnsignedInt

  name        String  @db.VarChar(150)
  cnpj        String  @unique @db.Char(14)
  address     String? @db.VarChar(255)
  email       String? @db.VarChar(150)
  ie          String? @db.VarChar(30)
  phoneNumber String? @db.VarChar(20)

  isActive Boolean @default(true)

  rewardFundBalance          Decimal @default(0) @db.Decimal(14, 4)
  rewardFundTotalContributed Decimal @default(0) @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyPeople    CompanyPerson[]
  rewardCategories RewardCategory[]
  rewards          Reward[]

  loyaltySettings CompanyLoyaltySettings?
}

// =====================================================
// COMPANY PERSON
// =====================================================

model CompanyPerson {
  idCompanyPerson Int @id @default(autoincrement()) @db.UnsignedInt

  Company_idCompany Int @db.UnsignedInt
  Person_idPerson   Int @db.UnsignedInt

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [Company_idCompany], references: [idCompany])
  person  Person  @relation(fields: [Person_idPerson], references: [idPerson])

  employee CompanyEmployee?
  customer CompanyCustomer?

  @@unique([Company_idCompany, Person_idPerson], map: "uq_company_person")
  @@index([Person_idPerson])
}

// =====================================================
// USER ROLES
// =====================================================

model UserRoles {
  idRole Int    @id @default(autoincrement()) @db.UnsignedInt
  role   String @unique @db.VarChar(50)

  employees CompanyEmployee[]
}

// =====================================================
// COMPANY EMPLOYEE
// =====================================================

model CompanyEmployee {
  idCompanyEmployee Int @id @default(autoincrement()) @db.UnsignedInt

  CompanyPerson_idCompanyPerson Int  @unique @db.UnsignedInt
  UserRoles_idRole              Int? @db.UnsignedInt

  admissionDate   DateTime? @db.Date
  terminationDate DateTime? @db.Date

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  companyPerson CompanyPerson @relation(fields: [CompanyPerson_idCompanyPerson], references: [idCompanyPerson])
  role          UserRoles?    @relation(fields: [UserRoles_idRole], references: [idRole])

  registeredCustomers CompanyCustomer[] @relation("CustomerRegisteredBy")
  registeredPurchases Purchase[]        @relation("PurchaseRegisteredBy")

  reviewedRewards CustomerReward[] @relation("CustomerRewardReviewedBy")

  @@index([UserRoles_idRole])
}

// =====================================================
// COMPANY CUSTOMER
// =====================================================

model CompanyCustomer {
  idCompanyCustomer Int @id @default(autoincrement()) @db.UnsignedInt

  CompanyPerson_idCompanyPerson Int @unique @db.UnsignedInt

  RegisteredByEmployee_idCompanyEmployee Int? @db.UnsignedInt

  registrationDate DateTime @default(now())

  isActive Boolean @default(true)

  whatsappOptIn   Boolean   @default(false)
  whatsappOptInAt DateTime?

  companyPerson CompanyPerson @relation(fields: [CompanyPerson_idCompanyPerson], references: [idCompanyPerson])

  registeredByEmployee CompanyEmployee? @relation("CustomerRegisteredBy", fields: [RegisteredByEmployee_idCompanyEmployee], references: [idCompanyEmployee])

  purchases       Purchase[]
  journey         CustomerJourney?
  customerRewards CustomerReward[]
  cycles          CustomerCycle[]

  @@index([RegisteredByEmployee_idCompanyEmployee])
}

// =====================================================
// USER
// =====================================================

model User {
  idUser Int @id @default(autoincrement()) @db.UnsignedInt

  Person_idPerson Int @unique @db.UnsignedInt

  userName     String @unique @db.VarChar(100)
  passwordHash String @db.VarChar(255)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [Person_idPerson], references: [idPerson])
}

// =====================================================
// PURCHASE
// =====================================================

model Purchase {
  idPurchase BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  CompanyCustomer_idCompanyCustomer      Int  @db.UnsignedInt
  RegisteredByEmployee_idCompanyEmployee Int? @db.UnsignedInt

  fiscalDocumentNumber String? @db.VarChar(60)

  amount Decimal @db.Decimal(12, 2)

  rewardFundContribution Decimal @default(0) @db.Decimal(14, 4)

  purchaseDate DateTime @default(now())

  customer             CompanyCustomer  @relation(fields: [CompanyCustomer_idCompanyCustomer], references: [idCompanyCustomer])
  registeredByEmployee CompanyEmployee? @relation("PurchaseRegisteredBy", fields: [RegisteredByEmployee_idCompanyEmployee], references: [idCompanyEmployee])

  @@index([CompanyCustomer_idCompanyCustomer])
  @@index([RegisteredByEmployee_idCompanyEmployee])
  @@index([purchaseDate])
}

// =====================================================
// CUSTOMER JOURNEY
// =====================================================

model CustomerJourney {
  idCustomerJourney BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  CompanyCustomer_idCompanyCustomer Int @unique @db.UnsignedInt

  progress   Decimal @default(0) @db.Decimal(10, 2)
  regularity Decimal @default(1) @db.Decimal(2, 1)

  updatedAt DateTime @updatedAt

  customer CompanyCustomer @relation(fields: [CompanyCustomer_idCompanyCustomer], references: [idCompanyCustomer])
}

// =====================================================
// COMPANY LOYALTY SETTINGS
// =====================================================

model CompanyLoyaltySettings {
  idCompanyLoyaltySettings Int @id @default(autoincrement()) @db.UnsignedInt

  Company_idCompany Int @unique @db.UnsignedInt

  minimumMedianCustomers Int @default(20)

  fallbackMedian Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [Company_idCompany], references: [idCompany])
}

// =====================================================
// CUSTOMER CYCLE
// =====================================================

model CustomerCycle {
  idCustomerCycle BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  CompanyCustomer_idCompanyCustomer Int @db.UnsignedInt

  cycleStart DateTime
  cycleEnd   DateTime

  purchaseDays Int?

  totalAmount Decimal? @db.Decimal(12, 2)

  frequencyLevel FrequencyLevel?
  valueLevel     ValueLevel?

  regularityLevel Decimal? @db.Decimal(2, 1)

  companyMedian    Decimal? @db.Decimal(12, 2)
  medianPercentage Decimal? @db.Decimal(8, 2)
  medianSampleSize Int?

  progressEarned Decimal? @db.Decimal(4, 2)

  status CustomerCycleStatus @default(OPEN)

  closedAt  DateTime?
  createdAt DateTime  @default(now())

  customer CompanyCustomer @relation(fields: [CompanyCustomer_idCompanyCustomer], references: [idCompanyCustomer])

  @@unique([CompanyCustomer_idCompanyCustomer, cycleStart], map: "uq_customer_cycle_start")
  @@index([status, cycleEnd])
}

// =====================================================
// REWARD CATEGORY
// =====================================================

model RewardCategory {
  idRewardCategory Int @id @default(autoincrement()) @db.UnsignedInt

  Company_idCompany Int @db.UnsignedInt

  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  company Company @relation(fields: [Company_idCompany], references: [idCompany])

  rewards         Reward[]
  customerRewards CustomerReward[]

  @@unique([Company_idCompany, name], map: "uq_rewardcategory_company_name")
}

// =====================================================
// REWARD
// =====================================================

model Reward {
  idReward Int @id @default(autoincrement()) @db.UnsignedInt

  Company_idCompany               Int  @db.UnsignedInt
  RewardCategory_idRewardCategory Int? @db.UnsignedInt

  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  // Custo financeiro da recompensa para a empresa.
  costAmount Decimal @default(0) @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  company  Company         @relation(fields: [Company_idCompany], references: [idCompany])
  category RewardCategory? @relation(fields: [RewardCategory_idRewardCategory], references: [idRewardCategory])

  customerRewards CustomerReward[]

  @@index([Company_idCompany])
  @@index([RewardCategory_idRewardCategory])
}

// =====================================================
// CUSTOMER REWARD
// =====================================================

model CustomerReward {
  idCustomerReward BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  CompanyCustomer_idCompanyCustomer Int @db.UnsignedInt

  ReviewedByEmployee_idCompanyEmployee Int? @db.UnsignedInt

  RewardCategory_idRewardCategory Int? @db.UnsignedInt
  Reward_idReward                 Int? @db.UnsignedInt

  // PENDING ainda não possui necessariamente
  // DIRECT ou CHOICE definido.
  rewardType CustomerRewardType?

  status CustomerRewardStatus @default(PENDING)

  // Categoria sugerida pelo motor.
  suggestedTier RewardTier?

  // Categoria efetivamente aprovada pelo admin.
  finalTier RewardTier?

  // Marco de progresso que gerou o direito.
  // Ex.: 20, 40, 60...
  progressMilestone Decimal? @db.Decimal(10, 2)

  // Regularidade no momento em que
  // o marco foi conquistado.
  regularityAtEarned Decimal? @db.Decimal(2, 1)

  // Momento em que o benefício poderá ser utilizado.
  redemptionTiming RewardRedemptionTiming?

  // Valor retirado/reservado do caixa.
  reservedAmount Decimal? @db.Decimal(10, 2)

  // Custo congelado da recompensa escolhida.
  costAmountSnapshot Decimal? @db.Decimal(10, 2)

  // Quando atingiu o marco.
  earnedAt DateTime @default(now())

  // Quando o admin analisou.
  reviewedAt DateTime?

  // Quando o admin aprovou.
  approvedAt DateTime?

  // Quando uma recompensa específica foi escolhida.
  selectedAt DateTime?

  // Quando foi utilizada.
  redeemedAt DateTime?

  // Data limite opcional.
  expiresAt DateTime?

  // Observação opcional da decisão.
  decisionNote String? @db.VarChar(255)

  customer CompanyCustomer @relation(fields: [CompanyCustomer_idCompanyCustomer], references: [idCompanyCustomer])

  reviewedByEmployee CompanyEmployee? @relation("CustomerRewardReviewedBy", fields: [ReviewedByEmployee_idCompanyEmployee], references: [idCompanyEmployee])

  rewardCategory RewardCategory? @relation(fields: [RewardCategory_idRewardCategory], references: [idRewardCategory])

  reward Reward? @relation(fields: [Reward_idReward], references: [idReward])

  @@unique([CompanyCustomer_idCompanyCustomer, progressMilestone], map: "uq_customer_reward_progress_milestone")
  @@index([CompanyCustomer_idCompanyCustomer])
  @@index([ReviewedByEmployee_idCompanyEmployee])
  @@index([RewardCategory_idRewardCategory])
  @@index([Reward_idReward])
  @@index([status, earnedAt])
  @@index([status, expiresAt])
}
